{
  "name": "beltwise",
  "version": "2.0.0",
  "private": true,
  "description": "A tiny, fast, touch-first factory automation game. Rust/Wasm simulation, WebGL2 instanced renderer.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.mjs --dev",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/preview.mjs",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/check-build.mjs",
    "test": "cargo test -p engine",
    "bench": "cargo test -p engine --release -- --ignored --nocapture"
  },
  "devDependencies": {
    "binaryen": "132.0.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
