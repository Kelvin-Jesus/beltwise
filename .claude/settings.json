{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cargo test *)",
      "Bash(cargo clippy *)",
      "Bash(cargo fmt *)",
      "Bash(cargo build *)",
      "Bash(cargo check *)",
      "Bash(npm test)",
      "Bash(npm run typecheck)",
      "Bash(npm run build)",
      "Bash(npm run bench)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)"
    ]
  },
  "extraKnownMarketplaces": {
    "better-harness": {
      "source": {
        "source": "github",
        "repo": "QoderAI/better-harness"
      }
    }
  },
  "enabledPlugins": {
    "better-harness@better-harness": true
  }
}
