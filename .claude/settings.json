{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cargo test *)",
      "Bash(cargo clippy *)",
      "Bash(cargo fmt *)",
      "Bash(cargo build *)",
      "Bash(cargo check *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "Bash(mise x -- npm test)",
      "Bash(mise x -- npm ci)",
      "Bash(mise x -- npm run typecheck)",
      "Bash(mise x -- npm run build)",
      "Bash(mise x -- npm run bench)",
      "Bash(mise x -- npm run check)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)"
    ]
  },
  "extraKnownMarketplaces": {
    "better-harness": {
      "source": {
        "source": "github",
        "repo": "QoderAI/better-harness"
      }
    }
  },
  "enabledPlugins": {
    "better-harness@better-harness": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/pre-push-check.sh",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
